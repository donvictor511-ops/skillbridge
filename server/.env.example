PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://skillbridge_app:change_me@localhost:5432/skillbridge
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Preferred: Brevo HTTPS email API (works from Render Free without SMTP ports).
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=SkillBridge <your-verified-sender@example.com>
# Alternative: Resend requires a verified sending domain for production delivery.
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM_EMAIL=SkillBridge <no-reply@mail.yourdomain.com>

# Optional sign-in providers. Set CLIENT_ORIGIN to the exact public website origin.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
