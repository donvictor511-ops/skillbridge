generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  professional
  client

  @@map("account_type")
}

enum ProfileVisibility {
  public
  members
  private

  @@map("profile_visibility")
}

enum BusinessSizeRange {
  size_1_10     @map("1-10")
  size_11_50    @map("11-50")
  size_51_200   @map("51-200")
  size_201_500  @map("201-500")
  size_501_plus @map("501+")

  @@map("business_size_range")
}

enum ConnectionStatus {
  pending
  accepted
  rejected

  @@map("connection_status")
}

enum NotificationType {
  follow
  connection_request
  connection_accepted
  post_like
  post_comment
  post_shared
  message
  community_post
  job_application
  job_application_update
  project_proposal
  project_proposal_update
  moderation_report
  account_appeal
  account_appeal_update
  content_moderation_update
  content_moderation_case
  interview_scheduled
  interview_updated
  community_invite

  @@map("notification_type")
}

enum CommunityRole {
  owner
  moderator
  member

  @@map("community_role")
}

enum CommunityInvitationStatus {
  pending
  accepted
  declined

  @@map("community_invitation_status")
}

enum CommunityReportStatus {
  pending
  reviewed
  dismissed
  actioned

  @@map("community_report_status")
}

enum UserRole {
  member
  admin

  @@map("user_role")
}

enum AuthProvider {
  google
  linkedin
  github

  @@map("auth_provider")
}

enum PostReportStatus {
  pending
  reviewed
  dismissed
  actioned

  @@map("post_report_status")
}

enum AccountAppealStatus {
  pending
  accepted
  rejected

  @@map("account_appeal_status")
}

enum ContentReviewStatus {
  published
  pending_review

  @@map("content_review_status")
}

enum PostReactionType {
  like
  love
  celebrate
  support
  insightful

  @@map("post_reaction_type")
}

enum ModerationCaseStatus {
  pending
  approved
  removed

  @@map("moderation_case_status")
}

enum ModeratedContentType {
  post
  comment
  community_post
  community_comment

  @@map("moderated_content_type")
}

enum CallKind {
  direct
  community
  interview

  @@map("call_kind")
}

enum CallMode {
  audio
  video

  @@map("call_mode")
}

enum CallStatus {
  active
  ended

  @@map("call_status")
}

enum CallParticipantStatus {
  invited
  joined
  declined
  left

  @@map("call_participant_status")
}

enum InterviewStatus {
  scheduled
  cancelled
  completed

  @@map("interview_status")
}

enum JobListingStatus {
  open
  closed

  @@map("job_listing_status")
}

enum ApplicationStatus {
  submitted
  reviewing
  accepted
  rejected
  withdrawn

  @@map("application_status")
}

enum ProjectListingStatus {
  open
  in_progress
  completed
  cancelled

  @@map("project_listing_status")
}

enum ProposalStatus {
  submitted
  shortlisted
  accepted
  rejected
  withdrawn

  @@map("proposal_status")
}

model User {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String                    @unique
  passwordHash            String                    @map("password_hash")
  capabilities            AccountType[]             @default([])
  role                    UserRole                  @default(member)
  suspendedAt             DateTime?                 @map("suspended_at")
  suspensionReason        String?                   @map("suspension_reason") @db.VarChar(1000)
  restrictedUntil         DateTime?                 @map("restricted_until")
  restrictionReason       String?                   @map("restriction_reason") @db.VarChar(1000)
  onboardedAt             DateTime?                 @map("onboarded_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  authIdentities          AuthIdentity[]
  profile                 Profile?
  skills                  UserSkill[]
  businessProfile         BusinessProfile?
  connectionsLow          Connection[]              @relation("ConnectionLowUser")
  connectionsHigh         Connection[]              @relation("ConnectionHighUser")
  connectionRequests      Connection[]              @relation("ConnectionRequester")
  following               Follow[]                  @relation("UserFollowing")
  followers               Follow[]                  @relation("UserFollowers")
  notificationsReceived   Notification[]            @relation("NotificationRecipient")
  notificationsSent       Notification[]            @relation("NotificationActor")
  posts                   Post[]
  postLikes               PostLike[]
  postCommentLikes        PostCommentLike[]
  postBookmarks           PostBookmark[]
  postComments            PostComment[]
  notificationPreference  NotificationPreference?
  notificationDevices     NotificationDevice[]
  presenceSessions       PresenceSession[]
  conversationsLow        Conversation[]            @relation("ConversationLowUser")
  conversationsHigh       Conversation[]            @relation("ConversationHighUser")
  conversationMemberships ConversationParticipant[]
  messagesSent            Message[]                 @relation("MessageSender")
  blocksMade              UserBlock[]               @relation("Blocker")
  blocksReceived          UserBlock[]               @relation("Blocked")
  reportsMade             UserReport[]              @relation("Reporter")
  reportsReceived         UserReport[]              @relation("Reported")
  appealsFiled            AccountAppeal[]           @relation("AppealUser")
  appealsResolved         AccountAppeal[]           @relation("AppealResolver")
  moderationCasesFiled    ModerationCase[]          @relation("ModerationCaseAuthor")
  moderationCasesResolved ModerationCase[]          @relation("ModerationCaseResolver")
  reportsResolved         UserReport[]              @relation("UserReportResolver")
  postReportsMade         PostReport[]              @relation("PostReportReporter")
  postReportsResolved     PostReport[]              @relation("PostReportResolver")
  postReportsReceived     PostReport[]              @relation("PostReportTargetUser")
  adminActionsMade        AdminAction[]             @relation("AdminActionActor")
  adminActionsReceived    AdminAction[]             @relation("AdminActionTargetUser")
  ownedCommunities        Community[]               @relation("CommunityOwner")
  communityMemberships    CommunityMember[]
  communityPosts          CommunityPost[]
  communityComments       CommunityComment[]
  communityInvitesSent     CommunityInvitation[] @relation("CommunityInviter")
  communityInvitesReceived CommunityInvitation[] @relation("CommunityInvitee")
  communityReports        CommunityReport[]         @relation("CommunityReporter")
  resolvedReports         CommunityReport[]         @relation("CommunityReportResolver")
  jobListings             JobListing[]              @relation("JobListingOwner")
  jobApplications         JobApplication[]          @relation("JobApplicant")
  projectListings         ProjectListing[]          @relation("ProjectListingOwner")
  projectProposals        ProjectProposal[]         @relation("ProjectProposalAuthor")
  callsStarted            CallSession[]              @relation("CallStarter")
  callParticipations      CallParticipant[]
  callMessages            CallMessage[]
  messageReactions        MessageReaction[]
  interviewsScheduled    Interview[]                @relation("InterviewScheduler")

  @@map("users")
}

model AuthIdentity {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject") @db.VarChar(255)
  createdAt       DateTime     @default(now()) @map("created_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model UserReport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String   @map("reporter_id") @db.Uuid
  reportedUserId String   @map("reported_user_id") @db.Uuid
  reason         String   @db.VarChar(40)
  details        String?  @db.VarChar(1000)
  status         CommunityReportStatus @default(pending)
  createdAt      DateTime @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")
  resolvedById   String?  @map("resolved_by_id") @db.Uuid
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User     @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolvedBy     User?    @relation("UserReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reportedUserId, createdAt])
  @@index([reporterId, createdAt])
  @@map("user_reports")
}

model Community {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String            @map("owner_id") @db.Uuid
  name        String            @db.VarChar(80)
  description String            @db.VarChar(600)
  guidelines  String            @default("") @db.VarChar(5000)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  owner       User              @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  posts       CommunityPost[]
  reports     CommunityReport[]
  callSessions CallSession[]
  invitations  CommunityInvitation[]

  @@index([name])
  @@index([ownerId])
  @@map("communities")
}

model CommunityMember {
  communityId String        @map("community_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        CommunityRole @default(member)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId, joinedAt])
  @@map("community_members")
}

model CommunityInvitation {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String                    @map("community_id") @db.Uuid
  inviterId   String                    @map("inviter_id") @db.Uuid
  inviteeId   String                    @map("invitee_id") @db.Uuid
  status      CommunityInvitationStatus @default(pending)
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  community   Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  inviter     User                      @relation("CommunityInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User                      @relation("CommunityInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([communityId, inviteeId])
  @@index([inviteeId, status, createdAt])
  @@map("community_invitations")
}

model CommunityPost {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String             @map("community_id") @db.Uuid
  authorId    String             @map("author_id") @db.Uuid
  content     String             @db.VarChar(3000)
  mediaUrl    String?            @map("media_url") @db.VarChar(2048)
  mediaType   String?            @map("media_type") @db.VarChar(10)
  moderationStatus ContentReviewStatus @default(published) @map("moderation_status")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  community   Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports     CommunityReport[]
  comments    CommunityComment[]

  @@index([communityId, createdAt])
  @@index([authorId, createdAt])
  @@map("community_posts")
}

model CommunityReport {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId  String                @map("community_id") @db.Uuid
  postId       String?               @map("post_id") @db.Uuid
  commentId    String?               @map("comment_id") @db.Uuid
  reporterId   String                @map("reporter_id") @db.Uuid
  resolvedById String?               @map("resolved_by_id") @db.Uuid
  reason       String                @db.VarChar(40)
  details      String?               @db.VarChar(1000)
  contentSnapshot String?            @map("content_snapshot") @db.VarChar(3000)
  status       CommunityReportStatus @default(pending)
  createdAt    DateTime              @default(now()) @map("created_at")
  resolvedAt   DateTime?             @map("resolved_at")
  community    Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post         CommunityPost?        @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment      CommunityComment?     @relation(fields: [commentId], references: [id], onDelete: SetNull)
  reporter     User                  @relation("CommunityReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?                 @relation("CommunityReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([communityId, status, createdAt])
  @@index([reporterId, createdAt])
  @@map("community_reports")
}

model CommunityComment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  content   String        @db.VarChar(2000)
  moderationStatus ContentReviewStatus @default(published) @map("moderation_status")
  createdAt DateTime      @default(now()) @map("created_at")
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reports   CommunityReport[]
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@map("community_comments")
}

model JobListing {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String           @map("owner_id") @db.Uuid
  title          String           @db.VarChar(140)
  description    String           @db.VarChar(8000)
  category       String           @db.VarChar(60)
  employmentType String           @map("employment_type") @db.VarChar(30)
  location       String?          @db.VarChar(120)
  isRemote       Boolean          @default(true) @map("is_remote")
  budgetMin      Decimal?         @map("budget_min") @db.Decimal(12, 2)
  budgetMax      Decimal?         @map("budget_max") @db.Decimal(12, 2)
  currency       String           @default("USD") @db.Char(3)
  status         JobListingStatus @default(open)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  owner          User             @relation("JobListingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  applications   JobApplication[]

  @@index([status, category, createdAt])
  @@index([ownerId, createdAt])
  @@map("job_listings")
}

model JobApplication {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String            @map("job_id") @db.Uuid
  applicantId String            @map("applicant_id") @db.Uuid
  coverLetter String            @map("cover_letter") @db.VarChar(5000)
  cvPublicId  String?           @map("cv_public_id") @db.VarChar(255)
  cvFormat    String?           @map("cv_format") @db.VarChar(10)
  cvFileName  String?           @map("cv_file_name") @db.VarChar(255)
  status      ApplicationStatus @default(submitted)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  job         JobListing        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant   User              @relation("JobApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  interview   Interview?

  @@unique([jobId, applicantId])
  @@index([applicantId, status, createdAt])
  @@index([jobId, status, createdAt])
  @@map("job_applications")
}

model ProjectListing {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String               @map("owner_id") @db.Uuid
  title        String               @db.VarChar(140)
  description  String               @db.VarChar(8000)
  category     String               @db.VarChar(60)
  skills       String[]             @default([])
  budget       Decimal?             @db.Decimal(12, 2)
  currency     String               @default("USD") @db.Char(3)
  deliveryTime String?              @map("delivery_time") @db.VarChar(100)
  status       ProjectListingStatus @default(open)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  owner        User                 @relation("ProjectListingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  proposals    ProjectProposal[]

  @@index([status, category, createdAt])
  @@index([ownerId, createdAt])
  @@map("project_listings")
}

model ProjectProposal {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  authorId       String         @map("author_id") @db.Uuid
  coverLetter    String         @map("cover_letter") @db.VarChar(5000)
  proposedBudget Decimal?       @map("proposed_budget") @db.Decimal(12, 2)
  deliveryTime   String?        @map("delivery_time") @db.VarChar(100)
  status         ProposalStatus @default(submitted)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  project        ProjectListing @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author         User           @relation("ProjectProposalAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([projectId, authorId])
  @@index([authorId, status, createdAt])
  @@index([projectId, status, createdAt])
  @@map("project_proposals")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model Profile {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  displayName      String             @map("display_name")
  headline         String?
  location         String?
  bio              String?            @db.VarChar(2000)
  avatarUrl        String?            @map("avatar_url") @db.VarChar(2048)
  coverUrl         String?            @map("cover_url") @db.VarChar(2048)
  visibility       ProfileVisibility  @default(members)
  interests        String[]           @default([])
  goals            String[]           @default([])
  spokenLanguages  String[]           @default([]) @map("spoken_languages")
  allowCommunityInvites Boolean        @default(true) @map("allow_community_invites")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences      Experience[]
  educationEntries EducationEntry[]
  projects         PortfolioProject[]

  @@map("profiles")
}

model Skill {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  nameKey   String                  @unique @map("name_key")
  createdAt DateTime                @default(now()) @map("created_at")
  users     UserSkill[]
  projects  PortfolioProjectSkill[]

  @@map("skills")
}

model UserSkill {
  userId    String   @map("user_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model Experience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  title       String    @db.VarChar(100)
  company     String    @db.VarChar(100)
  location    String?   @db.VarChar(100)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  description String?   @db.VarChar(2000)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experiences")
}

model EducationEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  school       String   @db.VarChar(120)
  degree       String?  @db.VarChar(100)
  fieldOfStudy String?  @map("field_of_study") @db.VarChar(100)
  startYear    Int?     @map("start_year") @db.SmallInt
  endYear      Int?     @map("end_year") @db.SmallInt
  description  String?  @db.VarChar(1000)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("education_entries")
}

model PortfolioProject {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String                  @map("profile_id") @db.Uuid
  title       String                  @db.VarChar(100)
  description String                  @db.VarChar(2000)
  projectUrl  String?                 @map("project_url") @db.VarChar(2048)
  imageUrl    String?                 @map("image_url") @db.VarChar(2048)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  profile     Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills      PortfolioProjectSkill[]

  @@index([profileId])
  @@map("portfolio_projects")
}

model PortfolioProjectSkill {
  projectId String           @map("project_id") @db.Uuid
  skillId   String           @map("skill_id") @db.Uuid
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
  @@map("portfolio_project_skills")
}

model BusinessProfile {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @unique @map("user_id") @db.Uuid
  companyName String             @map("company_name") @db.VarChar(120)
  websiteUrl  String?            @map("website_url") @db.VarChar(2048)
  industry    String?            @db.VarChar(100)
  sizeRange   BusinessSizeRange? @map("size_range")
  about       String?            @db.VarChar(2000)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model Connection {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userLowId     String           @map("user_low_id") @db.Uuid
  userHighId    String           @map("user_high_id") @db.Uuid
  requestedById String           @map("requested_by_id") @db.Uuid
  status        ConnectionStatus @default(pending)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  userLow     User @relation("ConnectionLowUser", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh    User @relation("ConnectionHighUser", fields: [userHighId], references: [id], onDelete: Cascade)
  requestedBy User @relation("ConnectionRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userLowId, status])
  @@index([userHighId, status])
  @@index([requestedById])
  @@map("connections")
}

model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followedId String   @map("followed_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("UserFollowers", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId, createdAt])
  @@index([followerId, createdAt])
  @@map("follows")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String           @map("actor_id") @db.Uuid
  type        NotificationType
  message     String           @db.VarChar(500)
  resourceId  String?          @map("resource_id") @db.Uuid
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  pushDelivery NotificationPushDelivery?

  @@index([recipientId, createdAt])
  @@index([recipientId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  userId          String   @id @map("user_id") @db.Uuid
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  pushEnabled     Boolean  @default(false) @map("push_enabled")
  postLikes       Boolean  @default(true) @map("post_likes")
  comments        Boolean  @default(true)
  mentions        Boolean  @default(true)
  messages        Boolean  @default(true)
  connections     Boolean  @default(true)
  groups          Boolean  @default(true)
  marketplace     Boolean  @default(true)
  platformUpdates Boolean  @default(true) @map("platform_updates")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationDevice {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  tokenHash       String   @unique @map("token_hash") @db.Char(64)
  encryptedToken  String   @map("encrypted_token")
  label           String   @default("Browser") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@map("notification_devices")
}

model NotificationPushDelivery {
  notificationId String       @id @map("notification_id") @db.Uuid
  recipientId    String       @map("recipient_id") @db.Uuid
  status         String       @default("pending") @db.VarChar(20)
  attempts       Int          @default(0)
  retryAt        DateTime?    @map("retry_at")
  leaseUntil     DateTime?    @map("lease_until")
  processedAt    DateTime?    @map("processed_at")
  lastError      String?      @map("last_error") @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, retryAt, leaseUntil, createdAt])
  @@map("notification_push_deliveries")
}

model PresenceSession {
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@index([lastSeenAt])
  @@map("presence_sessions")
}

model Post {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  repostOfId String?  @map("repost_of_id") @db.Uuid
  content    String   @db.VarChar(3000)
  moderationStatus ContentReviewStatus @default(published) @map("moderation_status")
  imageUrl   String?  @map("image_url") @db.VarChar(2048)
  videoUrl   String?  @map("video_url") @db.VarChar(2048)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  repostOf Post?         @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts  Post[]        @relation("PostReposts")
  likes    PostLike[]
  comments PostComment[]
  reports  PostReport[]
  bookmarks PostBookmark[]

  @@unique([authorId, repostOfId])
  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([repostOfId])
  @@map("posts")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reactionType PostReactionType @default(like) @map("reaction_type")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model PostBookmark {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_bookmarks")
}

model PostComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  parentCommentId String? @map("parent_comment_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String   @db.VarChar(2000)
  moderationStatus ContentReviewStatus @default(published) @map("moderation_status")
  imageUrl  String?  @map("image_url") @db.VarChar(2048)
  videoUrl  String?  @map("video_url") @db.VarChar(2048)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent PostComment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("CommentReplies")
  reports PostReport[]
  likes PostCommentLike[]

  @@index([postId, createdAt])
  @@index([parentCommentId, createdAt])
  @@index([authorId])
  @@map("post_comments")
}

model PostCommentLike {
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("post_comment_likes")
}

model PostReport {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId      String           @map("reporter_id") @db.Uuid
  reportedUserId  String           @map("reported_user_id") @db.Uuid
  postId          String?          @map("post_id") @db.Uuid
  commentId       String?          @map("comment_id") @db.Uuid
  reason          String           @db.VarChar(40)
  details         String?          @db.VarChar(1000)
  contentSnapshot String           @map("content_snapshot") @db.VarChar(3000)
  status          PostReportStatus @default(pending)
  createdAt       DateTime         @default(now()) @map("created_at")
  resolvedAt      DateTime?        @map("resolved_at")
  resolvedById    String?          @map("resolved_by_id") @db.Uuid
  reporter        User             @relation("PostReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User             @relation("PostReportTargetUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  post            Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment         PostComment?     @relation(fields: [commentId], references: [id], onDelete: SetNull)
  resolvedBy      User?            @relation("PostReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([reporterId, createdAt])
  @@map("post_reports")
}

model AdminAction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  targetType   String   @map("target_type") @db.VarChar(40)
  targetId     String?  @map("target_id") @db.Uuid
  action       String   @db.VarChar(40)
  reason       String   @db.VarChar(1000)
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation("AdminActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AdminActionTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  appeals      AccountAppeal[]

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_actions")
}

model AccountAppeal {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  adminActionId   String?             @map("admin_action_id") @db.Uuid
  status          AccountAppealStatus @default(pending)
  message         String              @db.VarChar(2000)
  resolutionNote  String?             @map("resolution_note") @db.VarChar(1000)
  createdAt       DateTime            @default(now()) @map("created_at")
  resolvedAt      DateTime?           @map("resolved_at")
  resolvedById    String?             @map("resolved_by_id") @db.Uuid
  user            User                @relation("AppealUser", fields: [userId], references: [id], onDelete: Cascade)
  adminAction     AdminAction?        @relation(fields: [adminActionId], references: [id], onDelete: SetNull)
  resolvedBy      User?               @relation("AppealResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@unique([userId, adminActionId])
  @@map("account_appeals")
}

model ModerationCase {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentType    ModeratedContentType @map("content_type")
  contentId      String               @map("content_id") @db.Uuid
  authorId       String?              @map("author_id") @db.Uuid
  contentSnapshot String              @map("content_snapshot") @db.VarChar(3000)
  category       String               @db.VarChar(60)
  explanation    String               @db.VarChar(500)
  confidence     Float
  communityName  String?              @map("community_name") @db.VarChar(80)
  status         ModerationCaseStatus @default(pending)
  decisionNote   String?              @map("decision_note") @db.VarChar(1000)
  createdAt      DateTime             @default(now()) @map("created_at")
  resolvedAt     DateTime?            @map("resolved_at")
  resolvedById   String?              @map("resolved_by_id") @db.Uuid
  author         User?                @relation("ModerationCaseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy     User?                @relation("ModerationCaseResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([contentType, contentId])
  @@map("moderation_cases")
}

model Conversation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userLowId  String   @map("user_low_id") @db.Uuid
  userHighId String   @map("user_high_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  userLow      User                      @relation("ConversationLowUser", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh     User                      @relation("ConversationHighUser", fields: [userHighId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  callSessions CallSession[]

  @@unique([userLowId, userHighId])
  @@index([userLowId, updatedAt])
  @@index([userHighId, updatedAt])
  @@map("conversations")
}

model Interview {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId    String          @unique @map("application_id") @db.Uuid
  scheduledById    String          @map("scheduled_by_id") @db.Uuid
  scheduledAt      DateTime        @map("scheduled_at")
  durationMinutes  Int             @default(30) @map("duration_minutes") @db.SmallInt
  mode             CallMode        @default(video)
  notes            String?         @db.VarChar(1000)
  status           InterviewStatus @default(scheduled)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  application      JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledBy      User            @relation("InterviewScheduler", fields: [scheduledById], references: [id], onDelete: Cascade)
  callSessions     CallSession[]

  @@index([scheduledAt, status])
  @@map("interviews")
}

model CallSession {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind           CallKind
  mode           CallMode
  status         CallStatus @default(active)
  createdById    String     @map("created_by_id") @db.Uuid
  conversationId String?    @map("conversation_id") @db.Uuid
  communityId    String?    @map("community_id") @db.Uuid
  interviewId    String?    @map("interview_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  endedAt        DateTime?  @map("ended_at")
  createdBy      User       @relation("CallStarter", fields: [createdById], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  community      Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  interview      Interview? @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  participants   CallParticipant[]
  messages       CallMessage[]

  @@index([conversationId, status, createdAt])
  @@index([communityId, status, createdAt])
  @@index([interviewId, status, createdAt])
  @@map("call_sessions")
}

model CallParticipant {
  callId   String                @map("call_id") @db.Uuid
  userId   String                @map("user_id") @db.Uuid
  status   CallParticipantStatus @default(invited)
  joinedAt DateTime?             @map("joined_at")
  leftAt   DateTime?             @map("left_at")
  call     CallSession           @relation(fields: [callId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@index([userId, status])
  @@map("call_participants")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at")
  lastReadAt     DateTime? @map("last_read_at")
  archivedAt     DateTime? @map("archived_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, archivedAt])
  @@map("conversation_participants")
}

model Message {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String    @map("conversation_id") @db.Uuid
  senderId         String    @map("sender_id") @db.Uuid
  content          String    @db.VarChar(5000)
  mediaUrl         String?   @map("media_url") @db.VarChar(2048)
  mediaType        String?   @map("media_type") @db.VarChar(10)
  createdAt        DateTime  @default(now()) @map("created_at")
  editedAt         DateTime? @map("edited_at")
  replyToId        String?   @map("reply_to_id") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")
  deletedForLowAt  DateTime? @map("deleted_for_low_at")
  deletedForHighAt DateTime? @map("deleted_for_high_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")
  reactions    MessageReaction[]

  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@map("messages")
}

model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model CallMessage {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId    String      @map("call_id") @db.Uuid
  senderId  String      @map("sender_id") @db.Uuid
  content   String      @default("") @db.VarChar(5000)
  mediaUrl  String?     @map("media_url") @db.VarChar(2048)
  mediaType String?     @map("media_type") @db.VarChar(10)
  createdAt DateTime    @default(now()) @map("created_at")
  call      CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
  @@map("call_messages")
}
