generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  professional
  client

  @@map("account_type")
}

enum ProfileVisibility {
  public
  members
  private

  @@map("profile_visibility")
}

enum BusinessSizeRange {
  size_1_10     @map("1-10")
  size_11_50    @map("11-50")
  size_51_200   @map("51-200")
  size_201_500  @map("201-500")
  size_501_plus @map("501+")

  @@map("business_size_range")
}

enum ConnectionStatus {
  pending
  accepted
  rejected

  @@map("connection_status")
}

enum NotificationType {
  connection_request
  connection_accepted

  @@map("notification_type")
}

model User {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String           @unique
  passwordHash          String           @map("password_hash")
  capabilities          AccountType[]    @default([])
  onboardedAt           DateTime?        @map("onboarded_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  sessions              Session[]
  profile               Profile?
  skills                UserSkill[]
  businessProfile       BusinessProfile?
  connectionsLow        Connection[]     @relation("ConnectionLowUser")
  connectionsHigh       Connection[]     @relation("ConnectionHighUser")
  connectionRequests    Connection[]     @relation("ConnectionRequester")
  notificationsReceived Notification[]   @relation("NotificationRecipient")
  notificationsSent     Notification[]   @relation("NotificationActor")
  posts                 Post[]
  postLikes             PostLike[]
  postComments          PostComment[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Profile {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  displayName      String             @map("display_name")
  headline         String?
  location         String?
  bio              String?            @db.VarChar(2000)
  avatarUrl        String?            @map("avatar_url") @db.VarChar(2048)
  coverUrl         String?            @map("cover_url") @db.VarChar(2048)
  visibility       ProfileVisibility  @default(members)
  interests        String[]           @default([])
  goals            String[]           @default([])
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences      Experience[]
  educationEntries EducationEntry[]
  projects         PortfolioProject[]

  @@map("profiles")
}

model Skill {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  nameKey   String                  @unique @map("name_key")
  createdAt DateTime                @default(now()) @map("created_at")
  users     UserSkill[]
  projects  PortfolioProjectSkill[]

  @@map("skills")
}

model UserSkill {
  userId    String   @map("user_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model Experience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  title       String    @db.VarChar(100)
  company     String    @db.VarChar(100)
  location    String?   @db.VarChar(100)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  description String?   @db.VarChar(2000)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experiences")
}

model EducationEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  school       String   @db.VarChar(120)
  degree       String?  @db.VarChar(100)
  fieldOfStudy String?  @map("field_of_study") @db.VarChar(100)
  startYear    Int?     @map("start_year") @db.SmallInt
  endYear      Int?     @map("end_year") @db.SmallInt
  description  String?  @db.VarChar(1000)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("education_entries")
}

model PortfolioProject {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String                  @map("profile_id") @db.Uuid
  title       String                  @db.VarChar(100)
  description String                  @db.VarChar(2000)
  projectUrl  String?                 @map("project_url") @db.VarChar(2048)
  imageUrl    String?                 @map("image_url") @db.VarChar(2048)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  profile     Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills      PortfolioProjectSkill[]

  @@index([profileId])
  @@map("portfolio_projects")
}

model PortfolioProjectSkill {
  projectId String           @map("project_id") @db.Uuid
  skillId   String           @map("skill_id") @db.Uuid
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
  @@map("portfolio_project_skills")
}

model BusinessProfile {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @unique @map("user_id") @db.Uuid
  companyName String             @map("company_name") @db.VarChar(120)
  websiteUrl  String?            @map("website_url") @db.VarChar(2048)
  industry    String?            @db.VarChar(100)
  sizeRange   BusinessSizeRange? @map("size_range")
  about       String?            @db.VarChar(2000)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model Connection {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userLowId     String           @map("user_low_id") @db.Uuid
  userHighId    String           @map("user_high_id") @db.Uuid
  requestedById String           @map("requested_by_id") @db.Uuid
  status        ConnectionStatus @default(pending)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  userLow     User @relation("ConnectionLowUser", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh    User @relation("ConnectionHighUser", fields: [userHighId], references: [id], onDelete: Cascade)
  requestedBy User @relation("ConnectionRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userLowId, status])
  @@index([userHighId, status])
  @@index([requestedById])
  @@map("connections")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String           @map("actor_id") @db.Uuid
  type        NotificationType
  message     String           @db.VarChar(500)
  resourceId  String?          @map("resource_id") @db.Uuid
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, isRead])
  @@map("notifications")
}

model Post {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String   @db.VarChar(3000)
  imageUrl  String?  @map("image_url") @db.VarChar(2048)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("post_comments")
}
