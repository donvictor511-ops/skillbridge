{
  "name": "skillbridge-server",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "tsx scripts/recoverKnownMigration.ts && prisma migrate deploy",
    "db:check": "tsx src/db/checkConnection.ts",
    "test:unit": "npm run build && node --test dist/modules/messages/presence.service.test.js dist/modules/notifications/deviceTokenCrypto.test.js dist/modules/notifications/pushDeliveryQueue.test.js",
    "admin:set": "tsx scripts/set-admin.ts",
    "test:smoke": "bash scripts/smoke-auth.sh",
    "test:smoke:profiles": "bash scripts/smoke-profiles.sh",
    "test:smoke:profile-sections": "bash scripts/smoke-profile-sections.sh",
    "test:smoke:profile-portfolio": "bash scripts/smoke-profile-portfolio.sh",
    "test:privacy": "tsx scripts/profile-privacy-check.ts",
    "test:smoke:connections": "bash scripts/smoke-connections.sh",
    "test:smoke:notifications": "bash scripts/smoke-notifications.sh",
    "test:smoke:posts": "bash scripts/smoke-posts.sh",
    "test:all": "npm run test:smoke && npm run test:smoke:profiles && npm run test:smoke:profile-sections && npm run test:smoke:profile-portfolio && npm run test:privacy && npm run test:smoke:connections && npm run test:smoke:notifications && npm run test:smoke:posts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "file-type": "^22.3.0",
    "firebase-admin": "^14.5.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
